{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperci.org/spec/v0.1/project.schema.json",
  "title": "PaperCI ProjectSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "project", "evidence", "claims", "stories", "reviews"],
  "properties": {
    "spec_version": { "const": "0.1" },
    "project": { "$ref": "#/$defs/projectMetadata" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "stories": {
      "type": "array",
      "items": { "$ref": "#/$defs/story" }
    },
    "reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/review" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9.-]+$" },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "status": {
      "enum": ["draft", "reviewed", "verified", "disputed", "superseded"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "species": { "type": "string", "minLength": 1 },
        "population": { "type": "string", "minLength": 1 },
        "system": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "generated_by": { "type": "string", "minLength": 1 },
        "generator_version": { "type": "string", "minLength": 1 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "n": { "type": "integer", "minimum": 0 },
        "description": { "type": "string" }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": ["experiment", "observational", "simulation", "qualitative", "review", "other", "unknown"]
        },
        "unit_of_analysis": { "type": "string", "minLength": 1 },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "randomized": { "enum": ["yes", "no", "unknown", "not_applicable"] },
        "blinded": { "enum": ["yes", "no", "unknown", "not_applicable"] },
        "paired": { "enum": ["yes", "no", "unknown", "not_applicable"] }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["confidence_interval", "credible_interval", "standard_error", "standard_deviation", "range", "other", "not_reported"] },
        "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "contrast": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["increase", "decrease", "null", "mixed", "not_applicable", "unknown"] },
        "effect": { "$ref": "#/$defs/effect" },
        "uncertainty": { "$ref": "#/$defs/uncertainty" },
        "p_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "multiplicity": { "enum": ["adjusted", "not_adjusted", "not_applicable", "not_reported", "unknown"] },
        "analysis": { "type": "string" }
      }
    },
    "projectMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "mode"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["sketch", "verified", "connected"] },
        "created_at": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "status", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["quantitative_result", "qualitative_observation", "figure_panel", "table", "dataset", "analysis_output", "external_source"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "source": { "$ref": "#/$defs/source" },
        "design": { "$ref": "#/$defs/design" },
        "result": { "$ref": "#/$defs/result" },
        "scope": { "$ref": "#/$defs/scope" },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "type", "strength", "status", "supports", "challenges", "assumptions", "alternatives"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["descriptive", "difference", "association", "temporal", "predictive", "causal_effect", "mediation", "mechanism", "generalization", "null", "resource"]
        },
        "strength": { "enum": ["observes", "suggests", "supports", "demonstrates", "establishes"] },
        "status": { "enum": ["candidate", "allowed", "conditional", "prohibited", "disputed", "superseded"] },
        "supports": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "challenges": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "alternatives": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scope": { "$ref": "#/$defs/scope" },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "claim_ids"],
      "properties": {
        "role": { "enum": ["setup", "tension", "discovery", "explanation", "mechanism", "validation", "boundary", "implication", "resolution"] },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure", "question", "evidence_ids", "claim_ids"],
      "properties": {
        "figure": { "type": "integer", "minimum": 1 },
        "question": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "proposedTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "distinguishes", "feasibility", "expected_information_gain", "dependencies"],
      "properties": {
        "design": { "type": "string", "minLength": 1 },
        "distinguishes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "feasibility": { "enum": ["low", "medium", "high", "unknown"] },
        "expected_information_gain": { "enum": ["low", "medium", "high", "unknown"] },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "blocks", "severity"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "severity": { "enum": ["central", "major", "minor"] },
        "competing_explanations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "proposed_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/proposedTest" }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "profile", "central_question", "central_claim", "claim_path", "beats", "figure_plan", "gaps", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "central_question": { "type": "string", "minLength": 1 },
        "central_claim": { "$ref": "#/$defs/id" },
        "claim_path": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/beat" }
        },
        "figure_plan": {
          "type": "array",
          "items": { "$ref": "#/$defs/figure" }
        },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap" }
        },
        "status": { "enum": ["candidate", "selected", "rejected", "superseded"] },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "actor", "decision", "timestamp"],
      "allOf": [
        {
          "if": {
            "properties": {
              "actor": {
                "properties": {
                  "kind": { "enum": ["model", "software"] }
                },
                "required": ["kind"]
              }
            },
            "required": ["actor"]
          },
          "then": {
            "properties": {
              "decision": { "const": "review" }
            }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["human", "model", "software"] },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        "decision": { "enum": ["review", "verify", "dispute", "supersede", "allow", "condition", "prohibit", "select", "reject"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      }
    }
  }
}
