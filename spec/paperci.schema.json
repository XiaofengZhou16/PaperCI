{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperci.org/spec/v0.4/project.schema.json",
  "title": "PaperCI ProjectSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "project", "evidence", "claims", "stories", "reviews"],
  "allOf": [
    {
      "if": {
        "properties": { "spec_version": { "enum": ["0.3", "0.4"] } },
        "required": ["spec_version"]
      },
      "then": { "required": ["hypotheses", "runs"] }
    }
  ],
  "properties": {
    "spec_version": { "enum": ["0.1", "0.2", "0.3", "0.4"] },
    "project": { "$ref": "#/$defs/projectMetadata" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "stories": {
      "type": "array",
      "items": { "$ref": "#/$defs/story" }
    },
    "hypotheses": {
      "type": "array",
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/review" }
    },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/runManifest" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9.-]+$" },
      "additionalProperties": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "status": {
      "enum": ["draft", "reviewed", "verified", "disputed", "superseded"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "species": { "type": "string", "minLength": 1 },
        "population": { "type": "string", "minLength": 1 },
        "system": { "type": "string", "minLength": 1 },
        "context": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "generated_by": { "type": "string", "minLength": 1 },
        "generator_version": { "type": "string", "minLength": 1 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "n": { "type": "integer", "minimum": 0 },
        "clusters": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "enum": ["experiment", "observational", "simulation", "qualitative", "review", "other", "unknown"]
        },
        "unit_of_analysis": { "type": "string", "minLength": 1 },
        "parent_unit": { "type": "string", "minLength": 1 },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        },
        "randomized": { "enum": ["yes", "no", "unknown", "not_applicable"] },
        "blinded": { "enum": ["yes", "no", "unknown", "not_applicable"] },
        "paired": { "enum": ["yes", "no", "unknown", "not_applicable"] }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["confidence_interval", "credible_interval", "standard_error", "standard_deviation", "range", "other", "not_reported"] },
        "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "lower": { "type": "number" },
        "upper": { "type": "number" },
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "contrast": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["increase", "decrease", "null", "mixed", "not_applicable", "unknown"] },
        "effect": { "$ref": "#/$defs/effect" },
        "uncertainty": { "$ref": "#/$defs/uncertainty" },
        "p_value": { "type": "number", "minimum": 0, "maximum": 1 },
        "multiplicity": { "enum": ["adjusted", "not_adjusted", "not_applicable", "not_reported", "unknown"] },
        "analysis": { "type": "string" }
      }
    },
    "projectMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "mode"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["sketch", "verified", "connected"] },
        "created_at": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "status", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["quantitative_result", "qualitative_observation", "figure_panel", "table", "dataset", "analysis_output", "external_source"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "source": { "$ref": "#/$defs/source" },
        "design": { "$ref": "#/$defs/design" },
        "result": { "$ref": "#/$defs/result" },
        "scope": { "$ref": "#/$defs/scope" },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "type", "strength", "status", "supports", "challenges", "assumptions", "alternatives"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["descriptive", "difference", "association", "temporal", "predictive", "causal_effect", "mediation", "mechanism", "generalization", "null", "resource"]
        },
        "strength": { "enum": ["observes", "suggests", "supports", "demonstrates", "establishes"] },
        "status": { "enum": ["candidate", "allowed", "conditional", "prohibited", "disputed", "superseded"] },
        "supports": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "challenges": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "alternatives": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scope": { "$ref": "#/$defs/scope" },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "ambitionDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "unknown"] },
        "basis": { "type": "string", "minLength": 1 }
      }
    },
    "noveltyAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note", "literature_sources"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["checked", "potentially_novel", "not_novel"] }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["checked_at"],
            "properties": { "literature_sources": { "minItems": 1 } }
          }
        }
      ],
      "properties": {
        "status": { "enum": ["unchecked", "checked", "potentially_novel", "not_novel"] },
        "note": { "type": "string", "minLength": 1 },
        "checked_at": { "type": "string", "format": "date-time" },
        "literature_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    },
    "inferenceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement", "grounded_in"],
      "properties": {
        "kind": { "enum": ["observed", "inferred", "speculative"] },
        "statement": { "type": "string", "minLength": 1 },
        "grounded_in": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "expectedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "expected"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 }
      }
    },
    "hypothesisTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "distinguishes", "expected_outcomes", "falsifier", "feasibility", "expected_information_gain", "dependencies"],
      "properties": {
        "design": { "type": "string", "minLength": 1 },
        "distinguishes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "expected_outcomes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/expectedOutcome" }
        },
        "falsifier": { "type": "string", "minLength": 1 },
        "feasibility": { "enum": ["low", "medium", "high", "unknown"] },
        "expected_information_gain": { "enum": ["low", "medium", "high", "unknown"] },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hypothesisFigure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure", "role", "question", "evidence_ids"],
      "properties": {
        "figure": { "type": "integer", "minimum": 1 },
        "role": { "enum": ["evidence_anchor", "mechanism_model", "discriminating_test", "boundary"] },
        "question": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "strategy", "status", "seed_claim", "anchor_claims", "evidence_ids", "inference_steps", "alternatives", "predictions", "decisive_tests", "evidence_upgrade_path", "evidence_distance", "ambition_profile", "novelty", "figure_plan"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["mechanistic-deepening", "cross-scale-bridge", "paradigm-challenge"] },
        "status": { "enum": ["speculative", "shortlisted", "rejected", "superseded"] },
        "seed_claim": { "$ref": "#/$defs/id" },
        "anchor_claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "inference_steps": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/inferenceStep" }
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "predictions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "decisive_tests": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hypothesisTest" }
        },
        "evidence_upgrade_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_distance": { "enum": ["near", "intermediate", "far", "unknown"] },
        "ambition_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["conceptual_advance", "explanatory_breadth", "cross_scale_reach", "discriminating_power", "testability", "feasibility"],
          "properties": {
            "conceptual_advance": { "$ref": "#/$defs/ambitionDimension" },
            "explanatory_breadth": { "$ref": "#/$defs/ambitionDimension" },
            "cross_scale_reach": { "$ref": "#/$defs/ambitionDimension" },
            "discriminating_power": { "$ref": "#/$defs/ambitionDimension" },
            "testability": { "$ref": "#/$defs/ambitionDimension" },
            "feasibility": { "$ref": "#/$defs/ambitionDimension" }
          }
        },
        "novelty": { "$ref": "#/$defs/noveltyAssessment" },
        "figure_plan": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hypothesisFigure" }
        },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "claim_ids"],
      "properties": {
        "role": { "enum": ["setup", "tension", "discovery", "explanation", "mechanism", "validation", "boundary", "implication", "resolution"] },
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figure", "question", "evidence_ids", "claim_ids"],
      "properties": {
        "figure": { "type": "integer", "minimum": 1 },
        "question": { "type": "string", "minLength": 1 },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "proposedTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "distinguishes", "feasibility", "expected_information_gain", "dependencies"],
      "properties": {
        "design": { "type": "string", "minLength": 1 },
        "distinguishes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "feasibility": { "enum": ["low", "medium", "high", "unknown"] },
        "expected_information_gain": { "enum": ["low", "medium", "high", "unknown"] },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "blocks", "severity"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "severity": { "enum": ["central", "major", "minor"] },
        "competing_explanations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "proposed_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/proposedTest" }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "profile", "central_question", "central_claim", "claim_path", "beats", "figure_plan", "gaps", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "central_question": { "type": "string", "minLength": 1 },
        "central_claim": { "$ref": "#/$defs/id" },
        "claim_path": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/beat" }
        },
        "figure_plan": {
          "type": "array",
          "items": { "$ref": "#/$defs/figure" }
        },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap" }
        },
        "status": { "enum": ["candidate", "selected", "rejected", "superseded"] },
        "extensions": { "type": "object", "additionalProperties": true }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["software", "model"] }
      }
    },
    "inputManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_ids", "claim_ids"],
      "properties": {
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "claim_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "runManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "provider", "input_hash", "input_manifest", "parameters", "output_ids", "status", "created_at"],
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "completed" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "output_ids": { "minItems": 1 } }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["story_proposal", "hypothesis_generation"] },
        "provider": { "$ref": "#/$defs/provider" },
        "input_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "input_manifest": { "$ref": "#/$defs/inputManifest" },
        "parameters": { "type": "object", "additionalProperties": true },
        "output_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "status": { "enum": ["completed", "failed"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "actor", "decision", "timestamp"],
      "allOf": [
        {
          "if": {
            "properties": {
              "actor": {
                "properties": {
                  "kind": { "enum": ["model", "software"] }
                },
                "required": ["kind"]
              }
            },
            "required": ["actor"]
          },
          "then": {
            "properties": {
              "decision": { "const": "review" }
            }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/id" },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["human", "model", "software"] },
            "id": { "type": "string", "minLength": 1 }
          }
        },
        "decision": { "enum": ["review", "verify", "dispute", "supersede", "allow", "condition", "prohibit", "select", "reject"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "note": { "type": "string" }
      }
    }
  }
}
